#!/usr/bin/env bash
# Symlink live config to this repo's dots/ (stow-style).
#   ./link        apply
#   ./link -n     dry run (print actions only)
#
# - A directory is linked whole ("folded") when the live copy contains nothing that
#   isn't in the repo and nothing under it is excluded; otherwise it is recursed into.
# - Anything replaced is moved to ~/.local/state/dotfiles-link-backup/<timestamp>/.
# - Paths in EXCLUDE (relative to dots/) are never linked: they are generated at
#   runtime or machine-specific. They are left completely untouched.
set -euo pipefail

REPO="$(cd "$(dirname "$0")" && pwd)"
SRC_ROOT="$REPO/dots"
DST_ROOT="$HOME"
BACKUP="$HOME/.local/state/dotfiles-link-backup/$(date +%Y%m%d-%H%M%S)"
DRY=false; [[ "${1:-}" == "-n" ]] && DRY=true

EXCLUDE=(
  .config/hypr/hyprland/colors.lua     # matugen output
  .config/hypr/hyprlock/colors.conf    # matugen output
  .config/fuzzel/fuzzel_theme.ini      # matugen output
  .config/kdeglobals                   # rewritten by KDE / material-you colours
  .config/fish/fish_variables          # rewritten by fish
  .config/hypr/hyprland.conf           # stub; its presence blocks the Lua config
  .config/hypr/monitors.lua            # machine-specific monitor layout
  .config/dolphinrc                    # rewritten by Dolphin (window/view state)
  .config/konsolerc                    # rewritten by Konsole (window state)
  .local/share/kxmlgui5                # KDE toolbar/menu layouts written at runtime
)

is_excluded() { local p; for p in "${EXCLUDE[@]}"; do [[ "$1" == "$p" ]] && return 0; done; return 1; }
has_excluded_under() { local p; for p in "${EXCLUDE[@]}"; do [[ "$p" == "$1/"* ]] && return 0; done; return 1; }

run() { echo "  $*"; $DRY || "$@"; }

backup() { # $1 = rel path
  echo "backup  ~/$1"
  run mkdir -p "$(dirname "$BACKUP/$1")"
  run mv "$DST_ROOT/$1" "$BACKUP/$1"
}

link() { # $1 = rel path
  echo "link    ~/$1 -> dots/$1"
  run ln -s "$SRC_ROOT/$1" "$DST_ROOT/$1"
}

# True if live dir $2 has any entry not present in repo dir $1
live_has_extra() {
  local s="$1" t="$2" e
  while IFS= read -r -d '' e; do
    [[ -e "$s/$e" || -L "$s/$e" ]] || return 0
  done < <(cd "$t" && find . -mindepth 1 \( -type f -o -type l \) -printf '%P\0')
  return 1
}

walk() { # $1 = rel dir ("" for root)
  local rel="$1" e r s t
  for s in "$SRC_ROOT/${rel:+$rel/}"* "$SRC_ROOT/${rel:+$rel/}".[!.]*; do
    [[ -e "$s" || -L "$s" ]] || continue
    e="$(basename "$s")"; r="${rel:+$rel/}$e"; t="$DST_ROOT/$r"
    [[ "$e" == .git ]] && continue

    is_excluded "$r" && continue

    if [[ -L "$t" && "$(readlink "$t")" == "$s" ]]; then continue; fi  # already linked

    if [[ -d "$s" && ! -L "$s" ]]; then
      if [[ ! -e "$t" && ! -L "$t" ]]; then
        if has_excluded_under "$r"; then run mkdir -p "$t"; walk "$r"; else link "$r"; fi
      elif [[ -d "$t" && ! -L "$t" ]]; then
        # Never fold the top-level containers (~/.config, ~/.local, ~/.local/share)
        if [[ "$r" == .config || "$r" == .local || "$r" == .local/share ]] || has_excluded_under "$r" || live_has_extra "$s" "$t"; then
          walk "$r"
        else
          backup "$r"; link "$r"
        fi
      else
        backup "$r"; link "$r"
      fi
    else
      [[ -e "$t" || -L "$t" ]] && backup "$r"
      run mkdir -p "$(dirname "$t")"
      link "$r"
    fi
  done
}

$DRY && echo "### DRY RUN — nothing will change"
walk ""
$DRY || { [[ -d "$BACKUP" ]] && echo "Backups: $BACKUP"; }
echo "Done."
